# ShopSphere Pro Configuration
APP_NAME=ShopSphere Pro
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=shopsphere-super-secure-production-jwt-secret-key-32-chars-min!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
DATABASE_URL=sqlite:///./shopsphere_pro.db

# Media Upload Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Super Admin Default Seed Credentials
SUPER_ADMIN_EMAIL=admin@shopsphere.com
SUPER_ADMIN_PASSWORD=Admin@ShopSphere2026!

